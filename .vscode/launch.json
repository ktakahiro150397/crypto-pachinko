{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backtest",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/backtest.ts",
      "args": ["2025-10-09", "2025-10-11"],
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Debug Backtest (Custom Date Range)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/backtest.ts",
      "args": [],
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
