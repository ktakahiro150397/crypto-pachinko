# Database configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=crypto_user
DB_PASSWORD=crypto_pass
DB_NAME=crypto_pachinko

# Price API configuration
# Options: mock, binance
PRICE_API_TYPE=mock

# Trading API configuration
# Options: mock, hyperliquid
TRADING_API_TYPE=mock

# Hyperliquid configuration (required when TRADING_API_TYPE=hyperliquid)
# WARNING: Keep this private key secure! Never commit .env file to git
HYPERLIQUID_PRIVATE_KEY=
# Set to true for testnet, false for mainnet
HYPERLIQUID_TESTNET=true
# Optional: Agent wallet address (required if using API Agent wallet)
HYPERLIQUID_WALLET_ADDRESS=
# Optional: Main wallet address (required for info API calls like getUserOpenOrders)
# This should be the original wallet address that the agent wallet is derived from
HYPERLIQUID_MAIN_WALLET_ADDRESS=
# Optional: Vault address for vault trading
HYPERLIQUID_VAULT_ADDRESS=

# Historical data provider configuration
# Options: mock, csv, binance
HISTORICAL_DATA_PROVIDER=mock
CSV_DATA_DIRECTORY=./data
HISTORICAL_DAYS_BACK=30

# Price collector settings
PRICE_COLLECTION_INTERVAL_MS=5000

# Trading bot settings
CRASH_THRESHOLD_PERCENTAGE=20
RECOVERY_CHECK_INTERVAL_MS=10000
